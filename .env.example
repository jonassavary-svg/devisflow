# Copie ce fichier sous le nom .env et colle UNE clé API (Anthropic OU OpenAI).

# Clé Anthropic (Claude) : console.anthropic.com
ANTHROPIC_API_KEY=

# Clé OpenAI : platform.openai.com/api-keys
OPENAI_API_KEY=

# Facultatif
# DEVISFLOW_PROVIDER=openai           # à mettre si les deux clés sont remplies : anthropic ou openai
# DEVISFLOW_MODEL=gpt-5-mini               # modèle utilisé (par défaut : gpt-5-mini avec OpenAI, claude-opus-5-5 avec Claude)
# DEVISFLOW_EFFORT=low                # low, medium ou high : plus haut = plus réfléchi mais plus lent (défaut : low avec OpenAI, medium avec Claude)
# PORT=3000
