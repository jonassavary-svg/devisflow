# Copie ce fichier sous le nom .env et colle UNE clé API (Anthropic OU OpenAI).

# Clé Anthropic (Claude) : console.anthropic.com
ANTHROPIC_API_KEY=

# Clé OpenAI : platform.openai.com/api-keys
OPENAI_API_KEY=

# Facultatif
# DEVISFLOW_PROVIDER=openai           # à mettre si les deux clés sont remplies : anthropic ou openai
# DEVISFLOW_MODEL=gpt-5               # modèle utilisé (par défaut : claude-opus-5-5 ou gpt-5)
# DEVISFLOW_EFFORT=medium             # Claude seulement : low, medium ou high
# PORT=3000
